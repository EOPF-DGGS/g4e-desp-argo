FROM y74y55mn.gra7.container-registry.ovh.net/healpix-private/g4e-jupyterhub-private:2026-10-01

# Image of the orbit pipeline (tf/workflows/orbit-to-healpix-pipeline.yaml):
# - healpix-convert: conversion functions (moved out of legacy-converters)
# - legacy-converters main: only the GRID4EARTH conversion settings
# - stac-scraper[s3], plus a checkout of its repository in /opt/stac-scraper
#   because the asset and collection templates live at the repository root
# The RUN ends with a smoke test (stac-scraper needs Python >= 3.12 for
# itertools.batched). The token is only used on command lines, never stored.
ARG HEALPIX_CONVERT_SHA=3aa72e03be22d94e6880fdd86d9f0b4298e0ea91
ARG LEGACY_CONVERTERS_SHA=a2b67a4f465beea5708b47328de8524f902dade6
ARG STAC_SCRAPER_SHA=62b5c0195ce2f0e2bbe8ad3f3caeb7c5e03853b5

USER root
RUN --mount=type=secret,id=github_token,mode=0444 \
    /srv/conda/envs/notebook/bin/pip list --format=freeze \
      | grep -v -i -E "^(legacy-converters|healpix-convert|stac-scraper)==" > /tmp/constraints.txt && \
    /srv/conda/envs/notebook/bin/pip install --no-cache-dir -c /tmp/constraints.txt \
      "healpix-convert @ git+https://github.com/GRID4EARTH/healpix-convert.git@${HEALPIX_CONVERT_SHA}" \
      "legacy-converters @ git+https://$(cat /run/secrets/github_token)@github.com/GRID4EARTH/legacy-converters.git@${LEGACY_CONVERTERS_SHA}" \
      "stac-scraper[s3] @ git+https://$(cat /run/secrets/github_token)@github.com/GRID4EARTH/stac-scraper.git@${STAC_SCRAPER_SHA}" && \
    rm -f /tmp/constraints.txt && \
    git init -q /opt/stac-scraper && \
    git -C /opt/stac-scraper remote add origin https://github.com/GRID4EARTH/stac-scraper.git && \
    git -C /opt/stac-scraper fetch -q --depth 1 \
      "https://$(cat /run/secrets/github_token)@github.com/GRID4EARTH/stac-scraper.git" ${STAC_SCRAPER_SHA} && \
    git -C /opt/stac-scraper checkout -q --detach FETCH_HEAD && \
    rm -rf /opt/stac-scraper/.git/FETCH_HEAD /opt/stac-scraper/.git/logs && \
    test -d /opt/stac-scraper/assets && test -d /opt/stac-scraper/collections && \
    chown -R ${NB_USER} /opt/stac-scraper && \
    /srv/conda/envs/notebook/bin/python -c \
      "import itertools, healpix_convert, legacy_converters, stac_scraper.cli; itertools.batched" && \
    /srv/conda/envs/notebook/bin/stac-scraper --help > /dev/null

USER ${NB_USER}
